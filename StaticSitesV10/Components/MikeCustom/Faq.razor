@if (Faqs is not null)
{

    @foreach (var i in Faqs)
    {
        <div class="container-fluid">
            <h3>@i.Question</h3>

            @foreach (var a in i.Answers)
            {
                <p class="lead">@a</p>
            }
        </div>
    }


@* 
    <div class="container-fluid">

        <h3>@Faqs.Question</h3>

        @foreach (var i in Faqs.Answers)
        {
            <p class="lead">@i</p>
        }

    </div> *@
}

@code {
    
    [Parameter]
    public IEnumerable<FrequentlyAskedQuestions>? Faqs { get; set; }

}