<div class="mb-4">

    <div class="card h-100 d-flex flex-column">

        <!-- Image -->
        <div class="bg-image hover-zoom ripple ripple-surface ripple-surface-light image-wrapper">

            <img src="@ImageUrl" alt="@Title" class="product-img" />

            @if (ShowBadges)
            {
                <div class="mask">
                    <div class="d-flex justify-content-start align-items-end h-100">
                        @if (IsNew)
                        {
                            <h5><span class="badge bg-primary ms-2">New</span></h5>
                        }
                        @if (IsEco)
                        {
                            <h5><span class="badge bg-success ms-2">Eco</span></h5>
                        }
                        @if (!string.IsNullOrEmpty(Discount))
                        {
                            <h5><span class="badge bg-danger ms-2">@Discount</span></h5>
                        }
                    </div>
                </div>
            }

            <div class="hover-overlay">
                <div class="mask" style="background-color: rgba(251, 251, 251, 0.15);"></div>
            </div>
        </div>

        <!-- Content -->
        <div class="card-body d-flex flex-column">

            <h3 class="card-title font-weight-bold mb-3"><a>@Title</a></h3>

            <p class="card-text">
                @Description
            </p>

            @if (!string.IsNullOrEmpty(Price))
            {
                <h6 class="display-6 mb-3">@Price</h6>
            }

            @if (ShowButton)
            {
                @if (UseModal)
                {
                    <button class="btn btn-primary mt-auto" @onclick="OnClick">
                        @ButtonText
                    </button>
                }else
                {
                    <a href="@ActionButtonUrl" class="btn btn-primary mt-auto">@ButtonText</a>
                }               
            }

        </div>

    </div>
</div>

@code {
    [Parameter] public string ImageUrl { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string? Price { get; set; }

    // Badges
    [Parameter] public bool ShowBadges { get; set; } = true;
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public bool IsEco { get; set; }
    [Parameter] public string? Discount { get; set; }

    // Button
    [Parameter] public bool ShowButton { get; set; } = false;
    [Parameter] public string ButtonText { get; set; } = "Buy";
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool UseModal { get; set; }
    [Parameter] public string? ActionButtonUrl { get; set; }
}