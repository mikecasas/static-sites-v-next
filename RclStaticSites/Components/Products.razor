@if (ProductGroup != null)
{
    <section style="background-color: #eee;">
        <div class="text-center container py-5">

            <div class="text-center">
                <h2 class="section-heading text-uppercase mb-4">@Title</h2>
            </div>

            <div class="row">
                @foreach (var i in ProductGroup.FullProducts)
                {
                    @if ((ItemCount == 3) || (ItemCount == 6) || (ItemCount == 9))
                    {
                        <div class="col-12 col-md-4">

                            <ProductCard ImageUrl="@i.ImageUrl"
                                Title="@i.Title"
                                Description="@i.Descr"
                                Price="@i.Price"
                                IsNew="true"
                                IsEco="true"
                                Discount="-10%"
                                ShowButton="true"
                                UseModal="@i.UseModal"
                                ActionButtonUrl="@i.ActionButtonUrl"
                                ButtonText="@i.ActionButtonText" />

                        </div>
                    }
                    else
                    {

                        <div class="col-12 col-md-6">                

                            <ProductCard ImageUrl="@i.ImageUrl"
                                Title="@i.Title"
                                Description="@i.Descr"
                                Price="@i.Price"
                                IsNew="true"
                                IsEco="true"
                                Discount="-10%"
                                ShowButton="true"
                                UseModal="@i.UseModal"
                                ActionButtonUrl="@i.ActionButtonUrl"
                                ButtonText="@i.ActionButtonText" />

                        </div>

                    }

                }
            </div>

        </div>
    </section>

    @*     <StaticSitesV10.Components.MikeCustom.Modals.BasicModal></StaticSitesV10.Components.MikeCustom.Modals.BasicModal> *@

}

@code {

    private RclStaticSites.Components.Modals.BasicModal? Modal { get; set; }
    private int ItemCount = 1;

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public ProductGroup? ProductGroup { get; set; }


    protected override void OnInitialized()
    {
        ItemCount = ProductGroup.Products.Count();
    }
}